FROM almalinux:10

SHELL ["/bin/bash", "-c"]
ENTRYPOINT ["/bin/bash"]

WORKDIR /bdsim

RUN yum -y install epel-release

RUN yum -y install git make wget \
    gcc gcc-c++ gcc-gfortran \
    xerces-c-devel zlib-devel \
    openssl-devel bison flex boost-devel expat-devel \
    which

# X11 
RUN yum -y install xorg-x11-server-Xwayland xorg-x11-xauth libX11-devel \
    libXpm-devel libXft-devel libXext-devel libXmu-devel 

# OpenGL (EGL GLX egl gl glu glx opengl xmesa)
RUN yum -y install freeglut-devel

# Python
RUN yum -y install python3 python3-pip python3-devel

# python packages
RUN /bdsim/venv-bdsim/bin/pip install scipy matplotlib numpy ipython pybind11 && \
    python3.12 -m venv /bdsim/venv-bdsim && \
    echo 'source /bdsim/venv-bdsim/bin/activate' >> /bdsim/setup.sh && \
    echo 'python : system default' >> /bdsim/README

# Qt5 
RUN yum -y install qt5-qtbase-devel

# Qt6
RUN yum -y install qt6-qtbase-devel 

# ROOT
RUN yum install -y xxhash-libs tbb-devel gsl-devel
RUN wget -q https://root.cern/download/root_v6.40.02.Linux-almalinux10.2-x86_64-gcc14.3.tar.gz && \
    tar -xzf root_v6.40.02.Linux-almalinux10.2-x86_64-gcc14.3.tar.gz && \
    rm -rfv root_v6.40.02.Linux-almalinux10.2-x86_64-gcc14.3.tar.gz&& \   
    echo 'source /bdsim/root/bin/thisroot.sh' >> /bdsim/setup.sh &&\
    echo 'root install dir : /bdsim/root' >> /bdsim/README

    
# HEPMC3
# RUN yum -y install HepMC3-devel
RUN source /bdsim/root/bin/thisroot.sh &&\
    wget -q http://hepmc.web.cern.ch/hepmc/releases/HepMC3-3.3.1.tar.gz &&\
    tar -xzf HepMC3-3.3.1.tar.gz                   &&\
    mkdir hepmc3-build                             &&\
    cd hepmc3-build                                &&\
    cmake -DHEPMC3_ENABLE_ROOTIO:BOOL=ON             \
          -DHEPMC3_ENABLE_PROTOBUFIO:BOOL=OFF        \
          -DHEPMC3_ENABLE_TEST:BOOL=OFF              \
          -DHEPMC3_INSTALL_INTERFACES:BOOL=ON        \
          -DHEPMC3_BUILD_STATIC_LIBS:BOOL=OFF        \
          -DHEPMC3_BUILD_DOCS:BOOL=OFF               \
          -DHEPMC3_ENABLE_PYTHON:BOOL=OFF            \
          ../HepMC3-3.3.1                          &&\
    make -j4                                     &&\
    make install                                 &&\
    cd ../                                       &&\
    rm -rf HepMC3-3.3.1.tar.gz HepMC3-3.3.1 hepmc3-build &&\
    echo 'HepMC3 install dir : /usr/local' >> /bdsim/README


# HDF5
RUN yum -y install hdf5-devel