FROM ubuntu:noble

RUN mkdir -p /run/systemd && echo 'docker' > /run/systemd/container

SHELL ["/bin/bash", "-c"]
ENTRYPOINT ["/bin/bash"]

WORKDIR /bdsim

# start with more uptodate packages
RUN apt-get update

# build essentials 
RUN DEBIAN_FRONTEND="noninteractive" apt -y install build-essential

RUN DEBIAN_FRONTEND="noninteractive" apt-cache search python qt5 qt6

# required packages
RUN DEBIAN_FRONTEND="noninteractive" apt-get -y install cmake cmake-curses-gui wget \
    xorg-dev freeglut3-dev qtbase5-dev qt5-qmake qt6-base-dev \
    python3 python3-pip python3-venv libssl-dev liblz4-dev git \
    libxerces-c-dev bison flex x11vnc xvfb fvwm \
    libboost-all-dev

# python packages
RUN python3 -m venv /bdsim/venv-bdsim && \
    /bdsim/venv-bdsim/bin/pip install scipy matplotlib numpy ipython pybind11 && \
    echo 'source /bdsim/venv-bdsim/bin/activate' >> /bdsim/setup.sh

# ROOT
RUN DEBIAN_FRONTEND="noninteractive" apt-get -y install libxxhash-dev libtbb-dev
RUN wget -q https://root.cern/download/root_v6.40.02.Linux-ubuntu24.04-x86_64-gcc13.3.tar.gz && \
    tar -xzf root_v6.40.02.Linux-ubuntu24.04-x86_64-gcc13.3.tar.gz && \
    rm -rf root_v6.40.02.Linux-ubuntu24.04-x86_64-gcc13.3.tar.gz && \
    echo 'source /bdsim/root/bin/thisroot.sh' >> /bdsim/setup.sh

# HEPMC3
# RUN DEBIAN_FRONTEND="noninteractive" apt-get -y install libhepmc3-dev
RUN source /bdsim/root/bin/thisroot.sh &&\
    DEBIAN_FRONTEND="noninteractive" apt-get -y install libvdt-dev &&\
    wget -q http://hepmc.web.cern.ch/hepmc/releases/HepMC3-3.3.1.tar.gz &&\
    tar -xzf HepMC3-3.3.1.tar.gz                   &&\
    mkdir hepmc3-build                             &&\
    cd hepmc3-build                                &&\
    cmake -DHEPMC3_ENABLE_ROOTIO:BOOL=ON             \
          -DHEPMC3_ENABLE_PROTOBUFIO:BOOL=OFF        \
          -DHEPMC3_ENABLE_TEST:BOOL=OFF              \
          -DHEPMC3_INSTALL_INTERFACES:BOOL=ON        \
          -DHEPMC3_BUILD_STATIC_LIBS:BOOL=OFF        \
          -DHEPMC3_BUILD_DOCS:BOOL=OFF               \
          -DHEPMC3_ENABLE_PYTHON:BOOL=OFF            \
          ../HepMC3-3.3.1                          &&\
      make -j4                                     &&\
      make install                                 &&\
      rm -rf HepMC3-3.3.1.tar.gz HepMC3-3.3.1 hepmc3-build

# HDF5
RUN DEBIAN_FRONTEND="noninteractive" apt-get -y install libhdf5-dev libhdf5-103-1t64 libhdf5-cpp-103-1t64

# Graphics deps
RUN apt install -y qtbase5-dev qtchooser qt5-qmake qtbase5-dev-tools xterm