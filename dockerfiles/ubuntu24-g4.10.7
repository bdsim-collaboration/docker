FROM bdsim/ubuntu24-base

# CLHEP
RUN wget https://proj-clhep.web.cern.ch/proj-clhep/dist1/clhep-2.4.6.2.tgz && \
    tar -xf clhep-2.4.6.2.tgz && rm -rf clhep-2.4.6.2.tgz && \
    mkdir clhep-build && cd clhep-build && cmake ../2.4.6.2/CLHEP/ && \
    make -j4 && make install && cd ../ && rm -rfv 2.4.6.2 clhep-build && \
    echo 'CLHEP install dir : /usr/local' >> /bdsim/README

# Geant4
RUN git clone -b v10.7.4-bdsim --single-branch https://github.com/bdsim-collaboration/geant4.git &&\
    mkdir geant4-build && cd geant4-build &&\
    cmake ../geant4 -DGEANT4_INSTALL_DATA=ON -DGEANT4_USE_GDML=ON -DGEANT4_USE_OPENGL_X11=ON -DGEANT4_USE_SYSTEM_CLHEP=ON -DGEANT4_USE_RAYTRACER_X11=ON -DGEANT4_USE_QT=ON &&\
    make -j4 && make install && cd ../ &&\
    rm -rfv geant4-build geant4 &&\
    echo 'source /usr/local/bin/geant4.sh' >> /bdsim/setup.sh &&\
    echo 'Geant4 install dir : /usr/local' >> /bdsim/README